{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harry2611/Video-Scene-Understanding-Pipeline/schemas/video_metadata.schema.json",
  "title": "Video Scene Understanding Metadata",
  "type": "object",
  "required": [
    "video_id",
    "source",
    "local_video_path",
    "created_at",
    "config",
    "frames",
    "temporal_windows",
    "scenes",
    "benchmark"
  ],
  "properties": {
    "video_id": { "type": "string" },
    "source": { "type": "string" },
    "local_video_path": { "type": "string" },
    "duration": { "type": ["number", "null"], "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "metadata_path": { "type": ["string", "null"] },
    "config": {
      "type": "object",
      "required": [
        "fps",
        "scene_detector",
        "classifier",
        "temporal_window_size",
        "temporal_stride",
        "clip_enabled",
        "quality_scoring_enabled",
        "multi_gpu_enabled"
      ],
      "properties": {
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "scene_detector": { "type": "string", "enum": ["histogram", "pyscenedetect"] },
        "classifier": { "type": "string", "enum": ["resnet50", "efficientnet_b0"] },
        "temporal_window_size": { "type": "integer", "minimum": 1 },
        "temporal_stride": { "type": "integer", "minimum": 1 },
        "clip_enabled": { "type": "boolean" },
        "quality_scoring_enabled": { "type": "boolean" },
        "multi_gpu_enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "frames": {
      "type": "array",
      "items": { "$ref": "#/$defs/frame" }
    },
    "temporal_windows": {
      "type": "array",
      "items": { "$ref": "#/$defs/temporal_window" }
    },
    "scenes": {
      "type": "array",
      "items": { "$ref": "#/$defs/scene" }
    },
    "benchmark": { "$ref": "#/$defs/benchmark" }
  },
  "$defs": {
    "label_score": {
      "type": "object",
      "required": ["label", "confidence"],
      "properties": {
        "label": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "required": ["frame_index", "timestamp", "path"],
      "properties": {
        "frame_index": { "type": "integer", "minimum": 0 },
        "timestamp": { "type": "number", "minimum": 0 },
        "path": { "type": "string" },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 },
        "quality": {
          "anyOf": [
            { "$ref": "#/$defs/frame_quality" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "frame_quality": {
      "type": "object",
      "required": ["blur_variance", "brightness", "quality_score", "is_low_quality", "flags"],
      "properties": {
        "blur_variance": { "type": "number", "minimum": 0 },
        "brightness": { "type": "number", "minimum": 0, "maximum": 255 },
        "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "is_low_quality": { "type": "boolean" },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "temporal_window": {
      "type": "object",
      "required": ["window_index", "start_timestamp", "end_timestamp", "frame_indices"],
      "properties": {
        "window_index": { "type": "integer", "minimum": 0 },
        "start_timestamp": { "type": "number", "minimum": 0 },
        "end_timestamp": { "type": "number", "minimum": 0 },
        "frame_indices": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": [
        "scene_id",
        "scene_index",
        "start_timestamp",
        "end_timestamp",
        "duration",
        "frame_indices",
        "labels",
        "confidence",
        "quality",
        "metadata"
      ],
      "properties": {
        "scene_id": { "type": "string" },
        "scene_index": { "type": "integer", "minimum": 0 },
        "start_timestamp": { "type": "number", "minimum": 0 },
        "end_timestamp": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "minimum": 0 },
        "frame_indices": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "representative_frame": { "type": ["string", "null"] },
        "labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/label_score" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "clip_embedding": {
          "type": ["array", "null"],
          "items": { "type": "number" }
        },
        "quality": {
          "anyOf": [
            { "$ref": "#/$defs/scene_quality" },
            { "type": "null" }
          ]
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "scene_quality": {
      "type": "object",
      "required": [
        "data_quality_score",
        "low_quality_frame_ratio",
        "usable_frame_count",
        "total_frame_count",
        "quality_grade",
        "recommended_action",
        "flags"
      ],
      "properties": {
        "data_quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "low_quality_frame_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "usable_frame_count": { "type": "integer", "minimum": 0 },
        "total_frame_count": { "type": "integer", "minimum": 0 },
        "quality_grade": { "type": "string", "enum": ["excellent", "good", "review", "poor", "unknown"] },
        "recommended_action": { "type": "string", "enum": ["accept", "review", "reject"] },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "benchmark": {
      "type": "object",
      "required": [
        "total_latency_ms",
        "frames_per_second",
        "total_frames",
        "stage_latencies"
      ],
      "properties": {
        "total_latency_ms": { "type": "number", "minimum": 0 },
        "frames_per_second": { "type": "number", "minimum": 0 },
        "total_frames": { "type": "integer", "minimum": 0 },
        "stage_latencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "latency_ms", "details"],
            "properties": {
              "name": { "type": "string" },
              "latency_ms": { "type": "number", "minimum": 0 },
              "details": { "type": "object" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
